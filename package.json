{
  "name": "cyberintelligencelab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node app-server/server.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "node --test tests/server/*.test.ts tests/client/*.test.mjs tests/runtime/*.test.ts tests/runtime/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include=\"backend/**/*.ts\" --test-coverage-include=\"app-server/**/*.ts\" --test-coverage-include=\"app/lib/**/*.ts\" --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=85 --test tests/server/*.test.ts tests/client/*.test.mjs tests/runtime/*.test.ts tests/runtime/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
